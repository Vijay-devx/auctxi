# =============================================================
# AuctXI — Environment Variables Template
# =============================================================
# Copy this file to .env and fill in your real values.
#   cp .env.example .env
#
# .env is gitignored — never commit it.
# =============================================================


# ── MySQL ──────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_USER=auctxi_user
MYSQL_PASSWORD=change_me_db_password


# ── RabbitMQ ───────────────────────────────────────────────────────────────────
RABBITMQ_USER=auctxi_rabbit
RABBITMQ_PASSWORD=change_me_rabbit_password


# ── JWT (shared between api-gateway and core-service) ──────────────────────────
# Must be a Base64-encoded string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970


# ── Groq AI ────────────────────────────────────────────────────────────────────
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=1024

# AI internal auth token (used by core-service → ai-service calls)
AI_INTERNAL_TOKEN=change_me_ai_internal_token

# LLM provider: "groq" or "ollama"
LLM_PROVIDER=groq

# Ollama (only needed if LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Redis chat history TTL in seconds
REDIS_CHAT_HISTORY_TTL=3600


# ── Razorpay (Payment Service) ─────────────────────────────────────────────────
# Use rzp_test_* keys for testing, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_TKd9utAdVXyhH1
RAZORPAY_KEY_SECRET=change_me_razorpay_secret


# ── SMTP / Email (Notification Service) ────────────────────────────────────────
# Set USE_MOCK_EMAIL=false to send real emails. Leave true to only log emails.
USE_MOCK_EMAIL=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=noreply@auctxi.com


# ── Spring Boot Mail (Core Service) ────────────────────────────────────────────
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_smtp_app_password
